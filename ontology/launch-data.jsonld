      ],
      "host": "RBM Partnership to End Malaria"
    },
    {
      "@id": "launch:stage-0",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "0",
      "prefLabel": "R&D and Clinical",
      "stageIndex": 0,
      "operatorNote": "Manufacturer and product development partnerships — product-specific; see each product's manufacturedBy / coDevelopedBy."
    },
    {
      "@id": "launch:stage-1",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "1",
      "prefLabel": "Stringent Regulatory Approval (SRA)",
      "stageIndex": 1,
      "operatedBy": [
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-ema",
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-fda"
      ],
      "operatorNote": "Stringent regulatory authorities — for malaria medicines usually the EMA via the Article 58 / EU-M4all procedure."
    },
    {
      "@id": "launch:stage-2",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "2",
      "prefLabel": "WHO recommendation",
      "stageIndex": 2,
      "operatedBy": "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-who-gmp",
      "operatorNote": "WHO Global Malaria Programme — its Guideline Development Group (GDG) reviews the evidence and decides whether WHO recommends.",
      "concurrentWith": "launch:stage-3"
    },
    {
      "@id": "launch:stage-3",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "3",
      "prefLabel": "WHO PQ listing",
      "stageIndex": 3,
      "operatedBy": "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-who-pq",
      "operatorNote": "WHO Prequalification — quality and manufacturing assessment, separate from the guideline decision.",
      "concurrentWith": "launch:stage-2"
    },
    {
      "@id": "launch:stage-4",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "4",
      "prefLabel": "Country registration",
      "stageIndex": 4,
      "operatedBy": "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-ama",
      "operatorNote": "National regulatory authorities, country by country — accelerated by the African Medicines Agency and WHO collaborative registration."
    },
    {
      "@id": "launch:stage-5",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "5",
      "prefLabel": "National policy adoption",
      "stageIndex": 5,
      "operatorNote": "Ministries of health and national malaria control programmes — they write the national treatment guidelines."
    },
    {
      "@id": "launch:stage-6",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "6",
      "prefLabel": "Procurement (public channels)",
      "stageIndex": 6,
      "operatedBy": [
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-global-fund",
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-pmi",
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-unicef"
      ],
      "operatorNote": "Global Fund, US PMI, UNICEF, domestic budgets and procurement agents — tenders, reference pricing, forecasting."
    },
    {
      "@id": "launch:stage-7",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "7",
      "prefLabel": "In-country delivery",
      "stageIndex": 7,
      "operatorNote": "Governments and implementing partners — supply chain, health-worker training, pharmacovigilance."
    },
    {
      "@id": "launch:term-ACT",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "ACT",
      "definition": "Artemisinin-based combination therapy — the standard class of malaria treatments pairing an artemisinin derivative with a longer-acting partner drug."
    },
    {
      "@id": "launch:term-SRA",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "SRA",
      "definition": "Stringent Regulatory Authority — the older WHO term for an advanced regulator such as EMA or the US FDA. WHO is replacing it with WHO-Listed Authorities (WLA), regulators assessed against WHO's performance indicators; existing SRAs are treated as WHO-listed during the transition."
    },
    {
      "@id": "launch:term-WLA",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "WLA",
      "definition": "WHO-Listed Authority — a regulator assessed by WHO as operating at an advanced level."
    },
    {
      "@id": "launch:term-EU-M4all",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "EU-M4all",
      "definition": "EU-Medicines for all, formerly the Article 58 procedure — EMA's scientific opinion on high-priority medicines intended for markets outside the EU."
    },
    {
      "@id": "launch:term-GDG",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "GDG",
      "definition": "Guideline Development Group — the group WHO convenes to make the recommendations in a WHO guideline, such as the WHO Guidelines for malaria. It reviews the graded evidence (GRADE) and agrees by consensus on the direction and strength of each recommendation (WHO handbook for guideline development, 2nd ed., 2014)."
    },
    {
      "@id": "launch:term-PQ",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "PQ",
      "definition": "WHO prequalification — the quality, safety and efficacy assessment whose outcome, a listing on the WHO prequalified-products list, supports eligibility under the quality assurance (QA) and procurement policies of UN agencies and major funders; specific policies and exceptions may differ."
    },
    {
      "@id": "launch:term-MFT",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "MFT",
      "definition": "Multiple first-line therapies — the deliberate, managed use of two or more effective ACTs in a population for treatment of uncomplicated malaria, either simultaneously or in rotation."
    },
    {
      "@id": "launch:term-EOI",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "EOI",
      "definition": "Expression of Interest — the WHO prequalification invitation list; a product must be on it before a PQ dossier can be assessed."
    },
    {
      "@id": "launch:term-AMA",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "AMA",
      "definition": "African Medicines Agency — the African Union's continental medicines agency, based in Kigali, set up to harmonise regulation across the member states that have ratified its treaty and to evaluate selected priority products. National regulators still grant marketing authorisation."
    },
    {
      "@id": "launch:term-PMI",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "PMI",
      "definition": "U.S. President's Malaria Initiative — a major bilateral funder and procurer of malaria commodities."
    },
    {
      "@id": "launch:term-MMV",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "MMV",
      "definition": "Medicines for Malaria Venture — product development partnership behind several antimalarials."
    },
    {
      "@id": "launch:term-PQR",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "PQR",
      "definition": "Price & Quality Reporting — the Global Fund database of procurement transactions (volumes and prices)."
    },
    {
      "@id": "launch:term-GMP",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "GMP",
      "definition": "Good Manufacturing Practice — quality standard verified by inspection of manufacturing sites."
    },
